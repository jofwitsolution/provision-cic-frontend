# Backend API origin (server-only). The browser calls same-origin /api/v1,
# which Next.js forwards to this origin. Required at build time.
# Local: http://localhost:4000 | Vercel: https://provision-cic-backend.vercel.app
API_ORIGIN=http://localhost:4000

# Public site URL (used for SEO)
NEXT_PUBLIC_SITE_URL=https://www.provisionsupportservice.co.uk

# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Leave empty to disable GTM
NEXT_PUBLIC_GTM_ID=

# Google Search Console meta tag verification token (fallback when DNS verification is not possible)
NEXT_PUBLIC_GSC_VERIFICATION=

# Tawk.to Live Chat Configuration
# Get these from https://dashboard.tawk.to/#/admin/property
NEXT_PUBLIC_TAWK_PROPERTY_ID=YOUR_PROPERTY_ID_HERE
NEXT_PUBLIC_TAWK_WIDGET_ID=YOUR_WIDGET_ID_HERE
